# Приклад налаштувань. Скопіюй у .env і заповни. Сам .env у git не потрапляє.

# --- На своєму комп'ютері досить одного рядка ---
DJANGO_DEBUG=1

# --- На сервері: DJANGO_DEBUG не задавати, а заповнити все нижче ---
# Секретний ключ (довгий випадковий рядок). Згенерувати:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=
# Адреса сайту (кілька — через кому)
# DJANGO_ALLOWED_HOSTS=racion.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://racion.example.com
# Пошта для питань про дані (показується на сторінці «Приватність»)
# DJANGO_CONTACT_EMAIL=racion.support@example.com
# Пошта для листів відновлення пароля — дані SMTP від поштового сервісу.
# Без DJANGO_EMAIL_HOST листи не відправляються, а друкуються в терміналі (зручно локально).
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=
# DJANGO_EMAIL_PASSWORD=
# DJANGO_FROM_EMAIL=Раціон <noreply@racion.example.com>
# Сайт стоїть за Caddy, який приймає HTTPS: 1 — довіряти його заголовкам X-Forwarded-*
# DJANGO_BEHIND_PROXY=1
# Де лежить база (необов'язково; типово db.sqlite3 у корені проєкту)
# DJANGO_DB_PATH=/srv/racion/data/db.sqlite3
# Скільки секунд браузер пам'ятає «лише HTTPS» (почни з 3600, потім 31536000)
# DJANGO_HSTS_SECONDS=3600
# HSTS для піддоменів і список попереднього завантаження браузерів — лише коли домен стабільний (важко скасувати)
# DJANGO_HSTS_SUBDOMAINS=1
# DJANGO_HSTS_PRELOAD=1
